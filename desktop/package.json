{
  "name": "nox-desktop",
  "productName": "Nox",
  "version": "1.1.0",
  "private": true,
  "description": "Nox desktop shell — always loads the live site so Vercel deploys show up automatically.",
  "author": "Nox",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.nox.desktop",
    "productName": "Nox",
    "copyright": "Nox",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "main.mjs",
      "preload.mjs",
      "engine.mjs",
      "offline.html",
      "icon.png",
      "config.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Nox"
    },
    "portable": {
      "artifactName": "Nox-portable.exe"
    }
  }
}
