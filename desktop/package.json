{
  "name": "nox-desktop",
  "productName": "Nox",
  "version": "1.3.9",
  "private": true,
  "description": "Nox for Windows — self-contained catalog, built-in VLC, and auto-update.",
  "author": "Nox",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.nox.desktop",
    "productName": "Nox",
    "copyright": "Nox",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/koffi/**",
      "vlc-host.mjs",
      "vlc-tracks.mjs",
      "node-child.mjs"
    ],
    "files": [
      "main.mjs",
      "preload.cjs",
      "engine.mjs",
      "catalog.mjs",
      "updater.mjs",
      "vlc.mjs",
      "vlc-host.mjs",
      "vlc-tracks.mjs",
      "node-child.mjs",
      "persist.mjs",
      "offline.html",
      "icon.png",
      "config.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "catalog",
        "filter": [
          "**/*"
        ]
      }
    ],
    "executableName": "Nox",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jerskatus",
        "repo": "nox",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "icon.png",
      "extraResources": [
        {
          "from": "vlc",
          "to": "vlc",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Nox",
      "uninstallDisplayName": "Nox",
      "artifactName": "Nox-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Nox-portable-${version}.exe"
    },
    "appImage": {
      "artifactName": "Nox-${version}.AppImage"
    }
  }
}
